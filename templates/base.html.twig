
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>{% block title %}Hay Park Cricket Club{% endblock %}</title>

    <meta name="description"
          content="Welcome to Hay Park Cricket Club. Find club news, fixtures, results and registration information.">

    {% block stylesheets %}
        <link
            href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
            rel="stylesheet"
        >
    {% endblock %}

    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}

        <script
            src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            defer>
        </script>
    {% endblock %}
</head>

<body>

    {# Navigation #}
    <nav class="navbar navbar-expand-lg navbar-dark site-navbar">
        <div class="container">

            
    <a class="navbar-brand d-flex align-items-center gap-3"
        href="{{ path('app_home') }}">

        <img
            src="{{ asset('images/hay-park-logo.jpeg') }}"
            alt="Hay Park Redbacks Cricket Club"
            class="club-logo"
        >

        <span class="fw-bold">
            HAY PARK <span class="brand-accent">REDBACKS</span>
        </span>
    </a>

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#mainNavbar"
                    aria-controls="mainNavbar"
                    aria-expanded="false"
                    aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNavbar">

                <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-3">
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_home') }}">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#fixtures">Fixtures</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#results">Results</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#about">About</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#sponsors">Sponsors</a>
                    </li>
                    <li class="nav-item">
                        <a class="btn btn-club ms-lg-2" href="#join">Join the Club</a>
                    </li>
                </ul>

            </div>
        </div>
    </nav>

    <main>
        {% block body %}{% endblock %}
    </main>

    {# Footer #}
    <footer class="site-footer py-5">
        <div class="container">
            <div class="row g-4">
                <div class="col-md-6">
                    <h5 class="fw-bold">Hay Park Cricket Club</h5>
                    <p class="text-white-50 mb-0">
                        Club news, fixtures, results and community cricket.
                    </p>
                </div>

                <div class="col-md-3">
                    <h6>Quick Links</h6>
                    <a href="#fixtures">Fixtures</a>
                    <a href="#results">Results</a>
                    <a href="#about">About Us</a>
                </div>

                <div class="col-md-3">
                    <h6>Get Involved</h6>
                    <a href="#join">Registration</a>
                    <a href="#sponsors">Sponsorship</a>
                </div>
            </div>

            <hr class="my-4">

            <p class="small text-white-50 mb-0">
                &copy; {{ "now"|date("Y") }} Hay Park Cricket Club.
                All rights reserved.
            </p>
        </div>
    </footer>

</body>
</html>
