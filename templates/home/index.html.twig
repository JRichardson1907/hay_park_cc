
{% extends 'base.html.twig' %}

{% block title %}Home | Hay Park Cricket Club{% endblock %}

{% block body %}

    {# HERO SECTION #}
    <section class="hero-section">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-8">
                    <span class="hero-eyebrow">
                        WELCOME TO HAY PARK CRICKET CLUB
                    </span>

                    <h1 class="hero-title mt-3">
                        TASTE THE<br>
                        <span class="brand-accent">POISON.</span>
                    </h1>

                    <p class="hero-description mt-4">
                        The official home of Hay Park Redbacks Cricket Club.
                        Follow our fixtures, results, teams and latest club news.
                    </p>

                    <div class="d-flex flex-wrap gap-3 mt-4">
                        <a href="#fixtures" class="btn btn-club btn-lg">
                            View Fixtures
                        </a>

                        <a href="#join" class="btn btn-outline-light btn-lg">
                            Join Our Club
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    {# QUICK LINKS #}
    <section class="quick-links py-4">
        <div class="container">
            <div class="row g-3 text-center">

                <div class="col-md-4">
                    <a href="#fixtures" class="quick-link-card">
                        <h5>Upcoming Fixtures</h5>
                        <span>See who's playing next &rarr;</span>
                    </a>
                </div>

                <div class="col-md-4">
                    <a href="#results" class="quick-link-card">
                        <h5>Latest Results</h5>
                        <span>Catch up on recent matches &rarr;</span>
                    </a>
                </div>

                <div class="col-md-4">
                    <a href="#join" class="quick-link-card">
                        <h5>Play Cricket</h5>
                        <span>Become a club member &rarr;</span>
                    </a>
                </div>

            </div>
        </div>
    </section>

    {# PLAYHQ-STYLE MATCH CENTRE #}
    {% include 'components/_match_centre.html.twig' with {
        matches: matches
    } %}

    {# ABOUT #}
    <section id="about" class="section-padding bg-light">
        <div class="container">
            <div class="row align-items-center g-5">

                <div class="col-lg-6">
                    <span class="section-label">OUR CLUB</span>
                    <h2 class="mb-4">More Than Just Cricket</h2>

                    <p class="lead">
                        Welcome to Hay Park Cricket Club.
                    </p>

                    <p>
                        Whether you're a player, supporter, volunteer
                        or looking to get involved, this is your
                        home for everything happening at the club.
                    </p>

                    <p>
                        Discover our teams, follow our progress
                        throughout the season and keep up with
                        the latest club news.
                    </p>
                </div>

                <div class="col-lg-6">
                    <div class="club-photo-placeholder">
                        <span>Club photograph coming soon</span>
                    </div>
                </div>

            </div>
        </div>
    </section>

    {# REGISTRATION #}
    <section id="join" class="join-section text-center">
        <div class="container">
            <h2>Want to Play Cricket?</h2>
            <p class="lead mt-3">
                Join Hay Park Cricket Club and become part of
                our cricket community.
            </p>

            <p class="small mt-4 mb-0">
                Online registration details coming soon.
            </p>
        </div>
    </section>

    {# SPONSORS #}
    <section id="sponsors" class="section-padding">
        <div class="container text-center">
            <span class="section-label">OUR PARTNERS</span>
            <h2 class="mb-4">Club Sponsors</h2>

            <p class="text-muted">
                We're grateful for the support of our club sponsors.
            </p>

            <div class="sponsor-placeholder mt-4">
                Sponsor logos coming soon
            </div>
        </div>
    </section>

{% endblock %}
